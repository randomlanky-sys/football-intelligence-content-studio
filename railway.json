{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd packages/web && pnpm install && pnpm run build",
    "env": {
      "NODE_ENV": "production"
    }
  },
  "deploy": {
    "startCommand": "cd packages/web && pnpm run start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}